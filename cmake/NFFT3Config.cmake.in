@PACKAGE_INIT@

# Re-find the dependencies that the exported targets link as imported targets.
# Our vendored FindFFTW3 is shipped next to this file; put it on the module path.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Precision this package was built for (drives FindFFTW3's variant search).
set(NFFT_PREC_SUFFIX "@NFFT_PREC_SUFFIX@")

include(CMakeFindDependencyMacro)
find_dependency(FFTW3)

include("${CMAKE_CURRENT_LIST_DIR}/NFFT3Targets.cmake")

check_required_components(NFFT3)
