+/* Gaussian window, phi(nx) = exp(-nx^2/b)/sqrt(pi b), phi_hut(t) = exp(-t^2 b).
+ *
+ * b_inv = 1/b and norm = 1/sqrt(pi b) are constant per axis, so no evaluation
+ * divides or takes a square root. */
+static inline R Y(gaussian_phi_hut)(R b, R t)
+{
+  return EXP(-(t * t) * b);
+}
+
+static inline R Y(gaussian_phi)(R b_inv, R norm, R nx)
+{
+  return EXP(-(nx * nx) * b_inv) * norm;
+}
+
+/* dst[l] = phi(nx0 - l) for l = 0 .. 2m+1.
+ *
+ * Fast Gaussian gridding, recentred. The neighbour ratio
+ *
+ *   phi(nx0 - (l+1)) / phi(nx0 - l) = exp((2 (nx0 - l) - 1) / b)
+ *
+ * is itself geometric: stepping l multiplies it by step = exp(-2/b), which is
+ * constant per axis. So the whole run is two exponentials and one division,
+ * whatever m, plus two multiplies per point in two branch-free loops.
+ *
+ * It is anchored at c, the grid point of the run nearest the node, rather than
+ * at an end. That is what keeps it in range: with |r| <= 1/2 the running factor
+ * stays inside exp(+-(m+1)/b), about 12 to 19 for the b this library uses,
+ * where anchoring at the end lets it reach exp(2(m+1)(2m+1)/b) -- 3e59 at
+ * m = 13, sigma = 2, which overflows single precision from m = 8 on. It is also
+ * the accurate order: the factor is stepped at most m+1 times rather than
+ * 2m+1, from the peak of the run rather than from its smallest value.
+ *
+ * c is clamped rather than assumed, so a caller whose run sits differently
+ * against the support still gets one evaluation per point. */
+static inline void Y(gaussian_phi_run)(R *dst, R b_inv, R norm, R step,
+  INT mi, R nx0)
+{
+  const INT last = 2 * mi + 1;
+  INT c = (INT)LRINT(nx0);
+  R r, p, g, w;
+  INT l;
+
+  if (c < 0)
+    c = 0;
+  else if (c > last)
+    c = last;
+
+  r = nx0 - (R)c;
+  p = EXP(-(r * r) * b_inv) * norm;
+  dst[c] = p;
+
+  g = EXP((K(2.0) * r - K(1.0)) * b_inv);
+
+  for (w = p, l = c + 1; l <= last; l++)
+  {
+    w *= g;
+    g *= step;
+    dst[l] = w;
+  }
+
+  g = step / EXP((K(2.0) * r - K(1.0)) * b_inv);
+
+  for (w = p, l = c - 1; l >= 0; l--)
+  {
+    w *= g;
+    g *= step;
+    dst[l] = w;
+  }
+}
